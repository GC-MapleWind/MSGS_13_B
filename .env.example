# --- PostgreSQL ---
POSTGRES_USER=maplewind
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://maplewind:change-me@localhost:5432/maplewind
CHATBOT_DATABASE_URL=postgresql+asyncpg://maplewind:change-me@localhost:5432/chatbot

# --- JWT 인증 설정 ---
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Admin ---
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- API 요청 가능 주소 ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- API 경로 설정 ---
API_V1_PREFIX=/api/v1
API_ROOT_PATH=
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# --- 카카오 로그인 설정 ---
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=

# --- 통합 compose에서 챗봇 컨테이너를 함께 띄울 때 사용 ---
CHATBOT_AUTHORIZATION_KEY=
CHATBOT_ADMIN_SESSION_SECRET=
CHATBOT_ADMIN_USERNAME=admin
CHATBOT_ADMIN_PASSWORD=
CHATBOT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=google-credentials.json
